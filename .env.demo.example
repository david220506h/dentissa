# Variables de la DEMO (docker-compose.demo.yml). El script demo/demo.ps1 (o demo.sh) copia este archivo
# como .env.demo y llena los valores vacíos al azar. .env.demo no se versiona. Nunca pongas aquí
# contraseñas reales ni de otro entorno.
POSTGRES_PASSWORD=
# Al menos 32 caracteres
JWT_SECRET=
# Puertos locales (solo 127.0.0.1)
PANEL_PUERTO=8080
MAILPIT_PUERTO=8026
