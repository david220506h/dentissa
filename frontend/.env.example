# Copia este archivo como .env.local (no se versiona) y ajusta los valores.

# Destino del proxy /api en desarrollo (backend ASP.NET Core)
API_PROXY_TARGET=http://localhost:5058

# Hosts extra permitidos por el servidor de desarrollo, separados por comas
# (por ejemplo, el dominio de un túnel). Vacío = solo localhost.
DEV_ALLOWED_HOSTS=

# Solo si el frontend debe llamar a la API sin el proxy (por ejemplo, en producción)
# VITE_API_URL=https://api.ejemplo.com/api
