{
 "ConnectionStrings": {
  "DefaultConnection": ""
},
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "DentissaAPI",
    "Audience": "DentissaApp",
    "ExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://192.168.1.17:5173"
    ]
  },
  "RateLimiting": {
    "Login": {
      "PorIpYCorreo": { "PermitLimit": 5, "WindowSeconds": 60 },
      "PorIp": { "PermitLimit": 30, "WindowSeconds": 60 }
    },
    "Registro": {
      "PorIp": { "PermitLimit": 3, "WindowSeconds": 600 }
    },
    "Publico": {
      "PorIp": { "PermitLimit": 60, "WindowSeconds": 60 }
    }
  },
  "Agenda": {
    "DisponibilidadPublicaMaxDias": 14
  },
  "Clinica": {
    "ZonaHoraria": "America/Mexico_City"
  },
  "Correo": {
    "Habilitado": false
  },
  "CatalogoImagenes": {
    "Ruta": "storage/catalogo",
    "TamanoMaximoBytes": 5242880
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}