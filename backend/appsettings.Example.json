{
  "_comentario": "Plantilla de configuración. No pongas secretos aquí ni en appsettings.json: usa user-secrets en desarrollo y variables de entorno en producción (ver docs/security-audit.md).",
  "ConnectionStrings": {
    "DefaultConnection": "Server=<servidor>;Database=DentissaDB;User Id=<usuario>;Password=<contraseña>;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "SecretKey": "<clave aleatoria de al menos 32 bytes>",
    "Issuer": "DentissaAPI",
    "Audience": "DentissaApp",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "CatalogoImagenes": {
    "Ruta": "storage/catalogo",
    "TamanoMaximoBytes": 5242880
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
