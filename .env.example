# Copia este archivo como .env (no se versiona) y define una contraseña propia.
# La usa docker-compose.yml para crear la base de desarrollo; la misma va en la
# cadena de conexión del backend (user-secrets).
POSTGRES_PASSWORD=
# Opcional: puerto local del contenedor (5432 por defecto). Usa otro si ya está ocupado
# y ponlo también en la cadena de conexión.
# POSTGRES_PORT=5433
